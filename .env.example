# ==============================================================================
# SMTP Configuration for Contact Form
# Copy this file to .env and fill in your actual SMTP credentials.
# ==============================================================================

# SMTP Server Host (e.g., mail.yourdomain.com or smtp.gmail.com)
SMTP_HOST=mail.example.com

# SMTP Port: 587 (TLS / STARTTLS) or 465 (SSL)
SMTP_PORT=587

# Encryption: tls or ssl
SMTP_SECURE=tls

# SMTP Authentication
SMTP_USER=user@example.com
SMTP_PASS=your-smtp-password

# Email Sender info
MAIL_FROM=no-reply@example.com
MAIL_FROM_NAME="Starfleet Innotech Inc."

# Where contact form submissions should be delivered
MAIL_TO=admin@sfio.co.nz

# Optional: Google reCAPTCHA v2 Secret Key (leave blank to disable captcha verification on localhost)
RECAPTCHA_SECRET_KEY=
